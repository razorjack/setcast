+/** Preserve selectors whose meaning changes when a decoded video becomes a canvas. */
+export function needsImageElement(document: Document): boolean {
+  try {
+    return [...document.styleSheets, ...document.adoptedStyleSheets].some((sheet) =>
+      rulesNeedImage(sheet.cssRules),
+    );
+  } catch {
+    // A cross-origin stylesheet cannot be inspected. Keep its existing element contract.
+    return true;
+  }
+}
+
+function rulesNeedImage(rules: CSSRuleList): boolean {
+  for (const rule of rules) {
+    if (
+      rule instanceof CSSImportRule &&
+      rule.styleSheet &&
+      rulesNeedImage(rule.styleSheet.cssRules)
+    )
+      return true;
+    if (
+      rule instanceof CSSStyleRule &&
+      /(^|[^\w-])(img|canvas)(?![\w-])|of-type|\\/i.test(rule.selectorText)
+    )
+      return true;
+    if ('cssRules' in rule && rulesNeedImage(rule.cssRules as CSSRuleList)) return true;
+  }
+  return false;
+}
