{
  "name": "@setcast/renderer-browser",
  "version": "0.1.0",
  "description": "Browser playback, live audio visualization and experimental offline export for Setcast.",
  "license": "MIT",
  "files": [
    "dist",
    "entry"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./player": "./src/browser/main.tsx",
    "./package.json": "./package.json",
    "./export": "./src/export/index.ts",
    "./export-scene": "./src/export/scene.tsx",
    "./preview": "./src/preview/server.ts",
    "./preview-ui": "./src/preview/main.tsx"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./player": "./dist/browser/main.mjs",
      "./package.json": "./package.json",
      "./export": "./dist/export/index.mjs",
      "./export-scene": "./dist/export/scene.mjs",
      "./preview": "./dist/preview/server.mjs",
      "./preview-ui": "./dist/preview/main.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@setcast/core": "workspace:*",
    "mediabunny": "catalog:",
    "playwright": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
